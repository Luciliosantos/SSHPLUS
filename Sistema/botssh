    --reply_markup "$keyboard_planos" --parse_mode html
}

gerar_pix(){
    local cid=$1 d=$2 v=$3 uid=$4 u=$5 s=$6 service=${7:-ssh}
    [[ -z "$MP_TOKEN" ]] && { ShellBot.sendMessage --chat_id "$cid" --text "❌ Mercado Pago não configurado no servidor."; return 1; }
    local res=$(curl -s -X POST https://api.mercadopago.com/v1/payments \
        -H "Authorization: Bearer $MP_TOKEN" \
        -H "Content-Type: application/json" \
        -d "{\"transaction_amount\":$v,\"description\":\"SSH $d dias\",\"payment_method_id\":\"pix\",\"payer\":{\"email\":\"a@b.com\"}}")
    local pix=$(echo "$res" | grep -o '"qr_code":"[^"]*"' | cut -d'"' -f4)
    local idpag=$(echo "$res" | grep -o '"id":[0-9]*' | grep -o '[0-9]*')
    [[ -z "$pix" ]] && { ShellBot.sendMessage --chat_id "$cid" --text "❌ Erro ao gerar PIX"; return; }
    echo "$idpag $cid $d $v $u $s $uid $service" >> pagamentos_pendentes
    ShellBot.sendMessage --chat_id "$cid" \
        --text "$(echo -e "💳 <b>PAGAMENTO VIA PIX</b>\n\nValor: R$ $v\n\nCopie e cola:\n<pre>$pix</pre>")" --parse_mode html
    ShellBot.sendMessage --chat_id "$ADMIN_ID" --text "📩 Pedido: $uid — $d dias — R$ $v"
}

processar_compra(){
    local p=$1 cid=${callback_query_message_chat_id} uid=${callback_query_from_id}
    local u="ssh$RANDOM" s=$((RANDOM%900000+100000)) d v service="ssh"
    case $p in
        p1) d=1; v=$V1 ;; p5) d=5; v=$V5 ;; p10) d=10; v=$V10 ;; p15) d=15; v=$V15 ;; p30) d=30; v=$V30 ;;
        xp1) d=1; v=$XHTTP_V1; service="xhttp" ;; xp5) d=5; v=$XHTTP_V5; service="xhttp" ;; xp10) d=10; v=$XHTTP_V10; service="xhttp" ;; xp15) d=15; v=$XHTTP_V15; service="xhttp" ;; xp30) d=30; v=$XHTTP_V30; service="xhttp" ;;
        *) return 1 ;;
    esac
    gerar_pix "$cid" "$d" "$v" "$uid" "$u" "$s" "$service"
}

verificar_pagamentos(){
    [[ ! -f pagamentos_pendentes ]] && return
    local tmp=$(mktemp)
    while read idpag cid d v u s uid service; do
        [[ -z "$idpag" || "$idpag" = \#* ]] && continue
        local st=$(curl -s -H "Authorization: Bearer $MP_TOKEN" "https://api.mercadopago.com/v1/payments/$idpag" | grep -o '"status":"[^"]*"' | cut -d'"' -f4)
        if [[ "$st" = "approved" ]]; then
            if [[ "$service" = "xhttp" ]]; then
                local xout
                xout=$("$XHTTP_MANAGER" add "$u" "$d" 2>&1)
                if [[ $? -ne 0 ]]; then
                    echo "$idpag $cid $d $v $u $s $uid $service" >> "$tmp"
                    ShellBot.sendMessage --chat_id "$cid" --text "⚠️ Pagamento aprovado, mas não foi possível criar o XHTTP automaticamente. O administrador precisa verificar o servidor."
                    continue
                fi
                ShellBot.sendMessage --chat_id "$cid" --text "$(echo -e "✅ <b>PAGAMENTO APROVADO</b>\n\n⚡ <b>XHTTP</b>\n\n<pre>$xout</pre>")" --parse_mode html
            else
                exp=$(date +%Y/%m/%d -d "+$d days")
                useradd -M -N -s /bin/false "$u" -e "$exp" 2>/dev/null
                echo -e "$s\n$s" | passwd "$u" 2>/dev/null
                local ip=$(cat /etc/IP)
                ShellBot.sendMessage --chat_id "$cid" \
                    --text "$(echo -e "✅ <b>PAGO!</b>\n\nIP: $ip\nUsuário: <code>$u</code>\nSenha: <code>$s</code>")" --parse_mode html
            fi
            [[ -n "$GRUPO_ID" ]] && ShellBot.sendMessage --chat_id "$GRUPO_ID" --text "✅ VENDA: $service — $d dias — R$ $v"
        else
            echo "$idpag $cid $d $v $u $s $uid" >> "$tmp"
        fi
    done < pagamentos_pendentes
    mv "$tmp" pagamentos_pendentes
}

# ========== FUNÇÕES ORIGINAIS — NÃO MEXI! ==========
criarteste() {
    [[ $(grep -wc ${callback_query_from_id} lista) != '0' ]] && {
        ShellBot.sendMessage --chat_id ${callback_query_message_chat_id} \
            --text "VC JA CRIOU SSH HOJE !"
        return 0
    }
    usuario=$(echo teste$(( RANDOM% + 250 )))
    senha=$((RANDOM% + 99999))
    limite='1'
    tempo='1'
    tuserdate=$(date '+%C%y/%m/%d' -d " +1 days")
    useradd -M -N -s /bin/false $usuario -e $tuserdate > /dev/null 2>&1
    (echo "$senha";echo "$senha") | passwd $usuario > /dev/null 2>&1
    echo "$senha" > /etc/SSHPlus/senha/$usuario
    echo "$usuario $limite" >> /root/usuarios.db
    echo "#!/bin/bash
pkill -f \"$usuario\"
userdel --force \"$usuario\"
grep -v ^\"$usuario\"[[:space:]] /root/usuarios.db > /tmp/ph ; cat /tmp/ph > /root/usuarios.db
rm -f /etc/SSHPlus/senha/$usuario 2>/dev/null
rm -rf /etc/SSHPlus/userteste/$usuario.sh 2>/dev/null" > /etc/SSHPlus/userteste/$usuario.sh
    chmod +x /etc/SSHPlus/userteste/$usuario.sh
    at -f /etc/SSHPlus/userteste/$usuario.sh now + $tempo hour > /dev/null 2>&1
    echo ${callback_query_from_id} >> lista
    ShellBot.sendMessage --chat_id ${callback_query_message_chat_id} \
    --text "$(echo -e "✅ <b>Criado com sucesso</b> ✅\n\nIP: $(cat /etc/IP)\nUSUARIO: <code>$usuario</code>\nSENHA: <code>$senha</code>\n\n⏳ Expira em: $tempo Hora")" \
    --parse_mode html
    return 0
}

