# === FUNÇÃO: GERA PIX NO MERCADO PAGO ===
gerar_pix() {
    local cid=$1
    local dias=$2
    local valor=$3
    local user_id=$4
    local usuario=$5
    local senha=$6
    
    # Cria cobrança no Mercado Pago
    local resposta=$(curl -s -X POST "https://api.mercadopago.com/v1/payments" \
        -H "Authorization: Bearer $MP_TOKEN" \
        -H "Content-Type: application/json" \
        -d '{
            "transaction_amount": '$valor',
            "description": "Acesso SSH - '$dias' dias",
            "payment_method_id": "pix",
            "payer": { "email": "cliente@exemplo.com" }
        }')
    
    local pix_copia=$(echo "$resposta" | grep -o '"qr_code":"[^"]*"' | cut -d'"' -f4)
    local id_pagamento=$(echo "$resposta" | grep -o '"id":[0-9]*' | grep -o '[0-9]*')
    
    if [[ -z "$pix_copia" || "$pix_copia" == "null" ]]; then
        ShellBot.sendMessage --chat_id "$cid" \
            --text "❌ Erro ao gerar PIX! Tente novamente mais tarde."
        return 1
    fi
    
    # Salva pra monitorar pagamento
    echo "$id_pagamento $cid $dias $valor $usuario $senha $user_id" >> pagamentos_pendentes
    
    # Envia PIX pro cliente
    ShellBot.sendMessage --chat_id "$cid" \
        --text "$(echo -e "💳 <b>PAGAMENTO VIA PIX</b>\n\n⏳ Plano: $dias Dias\n💰 Valor: R$ $valor\n\n📋 <b>COPIA E COLA:</b>\n<pre>$pix_copia</pre>\n\n⏳ Após pagar, aguarde até 5 minutos. O acesso será enviado automaticamente!")" \
        --parse_mode html
    
    # Avisa admin
    ShellBot.sendMessage --chat_id "$ADMIN_ID" \
        --text "📩 NOVA VENDA PENDENTE!\n\n👤 Cliente ID: $user_id\n⏳ Plano: $dias Dias\n💰 Valor: R$ $valor\n🔑 ID Pagamento: $id_pagamento"
    
    return 0
}

# === FUNÇÃO: VERIFICA PAGAMENTO ===
verificar_pagamentos() {
    [[ ! -f pagamentos_pendentes ]] && return 0
    
    while read -r id_pag cid dias valor usuario senha user_id; do
        [[ -z "$id_pag" || "$id_pag" == "#" ]] && continue
        
        local status=$(curl -s -H "Authorization: Bearer $MP_TOKEN" \
            "https://api.mercadopago.com/v1/payments/$id_pag" | grep -o '"status":"[^"]*"' | cut -d'"' -f4)
        
        if [[ "$status" == "approved" ]]; then
            # Cria o acesso
            local tuserdate=$(date '+%Y/%m/%d' -d "+$dias days")
            useradd -M -N -s /bin/false "$usuario" -e "$tuserdate" > /dev/null 2>&1
            (echo "$senha"; echo "$senha") | passwd "$usuario" > /dev/null 2>&1
            echo "$senha" > /etc/SSHPlus/senha/$usuario
            echo "$usuario $dias" >> /root/usuarios.db
            
            # Envia dados pro cliente
            ShellBot.sendMessage --chat_id "$cid" \
                --text "$(echo -e "✅ <b>PAGAMENTO CONFIRMADO!</b>\n\n🔐 SEUS DADOS DE ACESSO:\n\nIP: $(cat /etc/IP)\nUSUÁRIO: <code>$usuario</code>\nSENHA: <code>$senha</code>\n⏳ Válido por: $dias Dias\n\nObrigado pela compra! 🚀")" \
                --parse_mode html
            
            # Avisa grupo
            ShellBot.sendMessage --chat_id "$GRUPO_ID" \
                --text "✅ VENDA CONCLUÍDA!\n\n👤 Cliente: $user_id\n⏳ Plano: $dias Dias\n💰 Valor: R$ $valor"
            
            # Remove da lista
            sed -i "/$id_pag/d" pagamentos_pendentes
        fi
    done < pagamentos_pendentes
}

# === FUNÇÃO: TESTE GRÁTIS (1x por dia) ===
criarteste() {
    local cid=${callback_query_message_chat_id}
    local uid=${callback_query_from_id}
    
    [[ $(grep -wc "$uid" lista) -gt 0 ]] && {
        ShellBot.sendMessage --chat_id "$cid" \
            --text "⚠️ Você já gerou seu teste grátis hoje!\nTente novamente amanhã ou escolha um plano abaixo:" \
            --reply_markup "$keyboard_planos"
        return 0
    }
    
    local usuario="teste$(( RANDOM% + 2500 ))"
    local senha=$(( RANDOM%90000 + 10000 ))
    local tuserdate=$(date '+%Y/%m/%d' -d "+1 day")
    
    useradd -M -N -s /bin/false "$usuario" -e "$tuserdate" > /dev/null 2>&1
    (echo "$senha"; echo "$senha") | passwd "$usuario" > /dev/null 2>&1
    echo "$senha" > /etc/SSHPlus/senha/$usuario
    echo "$usuario 1" >> /root/usuarios.db
    
    echo "$uid" >> lista
    
    ShellBot.sendMessage --chat_id "$cid" \
        --text "$(echo -e "✅ <b>TESTE GRÁTIS CRIADO!</b>\n\nIP: $(cat /etc/IP)\nUSUÁRIO: <code>$usuario</code>\nSENHA: <code>$senha</code>\n⏳ Válido por: 24 Horas\n\n💬 Gostou? Escolha um plano para continuar usando!")" \
        --parse_mode html
    return 0
}

# === FUNÇÃO: PROCESSAR COMPRA DE PLANO ===
processar_compra() {
    local plano=$1
    local cid=${callback_query_message_chat_id}
    local uid=${callback_query_from_id}
    local usuario="ssh$(( RANDOM% + 100000 ))"
    local senha=$(( RANDOM%900000 + 100000 ))
    
    case "$plano" in
        plano_1)  dias=1;  valor=$VALOR_1DIA ;;
        plano_5)  dias=5;  valor=$VALOR_5DIAS ;;
        plano_10) dias=10; valor=$VALOR_10DIAS ;;
        plano_15) dias=15; valor=$VALOR_15DIAS ;;
        plano_30) dias=30; valor=$VALOR_30DIAS ;;
    esac
    
    gerar_pix "$cid" "$dias" "$valor" "$uid" "$usuario" "$senha"
}

