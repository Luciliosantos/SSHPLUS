#!/bin/bash
clear
#--------[ DESENVOLVIDO POR @LNS-PRO ]-----------#
source ShellBot.sh
touch lista pagamentos_pendentes
[[ -z $1 ]] && {
    clear && echo "INFORME O TOKEN" && return 0
}

api_bot=$1
# Configurações ficam fora do código para não expor segredos no GitHub.
BOT_CONFIG="/etc/SSHPlus/bot.conf"
[[ -f "$BOT_CONFIG" ]] && source "$BOT_CONFIG"
ADMIN_ID="${ADMIN_ID:-${2:-}}"
GRUPO_ID="${GRUPO_ID:-}"
MP_TOKEN="${MP_TOKEN:-}"
ip_server2="${ip_server2:-SEU-IP-AQUI}"
senha_server2="${senha_server2:-SUA-SENHA-AQUI}"
ip_server3="${ip_server3:-SEU-IP-AQUI}"
senha_server3="${senha_server3:-SUA-SENHA-AQUI}"

V1="1.00"; V5="4.00"; V10="10.00"; V15="14.00"; V30="20.00"
XHTTP_V1="1.00"; XHTTP_V5="4.00"; XHTTP_V10="10.00"; XHTTP_V15="14.00"; XHTTP_V30="20.00"
XHTTP_MANAGER="/bin/xhttp-manager"

[[ ! -e RESET ]] && touch RESET
ShellBot.init --token "$api_bot" --monitor --flush
ShellBot.username

