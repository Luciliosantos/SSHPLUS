# ========== XHTTP ==========
xhttp_ready() {
    [[ -x "$XHTTP_MANAGER" ]] && return 0
    [[ -x "/etc/SSHPlus/xhttp-manager" ]] && { XHTTP_MANAGER="/etc/SSHPlus/xhttp-manager"; return 0; }
    return 1
}

xhttp_test() {
    local cid=${callback_query_message_chat_id} uid=${callback_query_from_id}
    if ! xhttp_ready; then
        ShellBot.sendMessage --chat_id "$cid" --text "❌ XHTTP ainda não foi instalado no servidor. Peça ao administrador para executar: <code>xhttp-manager setup</code>" --parse_mode html
        return 0
    fi
    mkdir -p /etc/SSHPlus/xhttp
    local mark="/etc/SSHPlus/xhttp/test-$uid"
    [[ -f "$mark" ]] && { ShellBot.sendMessage --chat_id "$cid" --text "⚠️ Você já criou um teste XHTTP hoje."; return 0; }
    local out user days=1
    user="xt$((RANDOM%9000+1000))"
    out=$("$XHTTP_MANAGER" add "$user" "$days" 2>&1) || {
        ShellBot.sendMessage --chat_id "$cid" --text "❌ Não foi possível criar o teste XHTTP. Verifique o servidor."; return 0;
    }
    touch "$mark"
    ShellBot.sendMessage --chat_id "$cid" --text "$(echo -e "⚡ <b>TESTE XHTTP CRIADO</b> ⚡\n\n<pre>$out</pre>")" --parse_mode html
}

mostrar_xhttp() {
    local cid=${callback_query_message_chat_id}
    ShellBot.sendMessage --chat_id "$cid" --text "$(echo -e "<b>⚡ XHTTP</b>\n\nEscolha uma opção:")" --reply_markup "$keyboard_xhttp" --parse_mode html
